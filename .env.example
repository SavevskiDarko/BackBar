# Vite bakes these into the bundle at BUILD time. They are not the same as the
# Worker's runtime secrets — see worker/README.md for those.
#
# Anything here is visible in the browser, which is fine: the anon key is meant
# to be public, and row-level security is what protects the data.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Only needed for `npm run dev`. In production the Worker serves this app from
# the same origin, so the default relative path /api/auth is correct.
# VITE_AUTH_URL=https://backbar.darko-savevski.workers.dev/api/auth

# NEVER put the service_role / sb_secret key here. It bypasses every security
# rule. It lives only in Worker secrets: npx wrangler secret put SUPABASE_SERVICE_ROLE_KEY
