# Copy to .env.local and fill in once you wire up Supabase.
# Vite only exposes variables prefixed with VITE_ to the browser.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Only needed for `npm run dev`. In production the Worker serves this app from
# the same origin, so the default relative path /api/auth is correct.
# VITE_AUTH_URL=https://backbar.darko-savevski.workers.dev/api/auth

# NEVER put the service_role key here. It bypasses every security rule.
# It lives only in Worker secrets: npx wrangler secret put SUPABASE_SERVICE_ROLE_KEY
